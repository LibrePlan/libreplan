<?taglib uri="/WEB-INF/tld/i18n.tld" prefix="i18n" ?>

<tabpanel id="${arg.id}">

    <grid>
        <columns>
            <column width="300px"/>
            <column />
        </columns>
        <rows>
            <row>
                <label value="${i18n:_t('Name')}" />
                <textbox id="name" value="@load(propertiesController.taskName)@save(propertiesController.taskName)" width="400px" />
            </row>
            <row>
                <label value="${i18n:_t('Start')}" />
                <datebox id="startDateBox" disabled="true"
                         value = "@load(propertiesController.taskBeginDate)" />
            </row>
            <row>
                <label value="${i18n:_t('End')}" />
                <datebox id="endDateBox" disabled="true"
                         value = "@load(propertiesController.taskEndDate)" />
            </row>
            <row>
                <label value="${i18n:_t('Deadline')}"/>
                <datebox id="deadLineDateBox" value = "@load(propertiesController.taskDeadlineDate)@save(propertiesController.taskDeadlineDate)"/>
            </row>
            <row>
                <label value="${i18n:_t('Notes')}" />
                <textbox id="notes" value="@load(propertiesController.taskNotes)@save(propertiesController.taskNotes)" width="400px" rows="3"/>
            </row>
            <row>
                <label value="${i18n:_t('Hours')}" />
                <intbox id="hours" disabled="true" />
            </row>
            <row id="durationRow">
                <label value="${i18n:_t('Duration (days)')}" />
                <intbox id="duration" disabled="true"/>
            </row>
            <row>
                <label value="${i18n:_t('Budget')}" />
                <decimalbox id="budget" disabled="true"
                            format="@load(propertiesController.moneyFormat)" />
            </row>
            <row id="startConstraint">
                <label value="${i18n:_t('Constraint')}" />
                <hbox>
                    <combobox id="startConstraintTypes" width="180px" />
                    <datebox id="startConstraintDate" constraint ="no empty"/>
                </hbox>
            </row>
            <row id="resourceAllocationType" visible="@load(editController.task)">
                <label value="${i18n:_t('Resource allocation type')}" />
                <listbox id="lbResourceAllocationType"
                         mold="select"
                         model="@load(propertiesController.resourceAllocationTypeOptionList)"
                         selectedItem="@load(propertiesController.resourceAllocationType)@save(propertiesController.resourceAllocationType)"/>
            </row>
        </rows>
    </grid>

</tabpanel>

