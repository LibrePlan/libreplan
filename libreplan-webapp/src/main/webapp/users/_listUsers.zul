<window id="${arg.top_id}" title="${i18n:_t('Users List')}">
    <newdatasortablegrid id="listing" model="@load(controller.users)" mold="paging"
        pageSize="10" sclass="clickable-rows"
        rowRenderer="@load(controller.usersRenderer)">
        <columns sizable="true">
            <newdatasortablecolumn label="${i18n:_t('Username')}" 
            sort="auto(lower(loginName))" sortDirection="ascending"/>
            <newdatasortablecolumn label="${i18n:_t('Disabled')}" />
            <newdatasortablecolumn label="${i18n:_t('Superuser')}" />
            <newdatasortablecolumn label="${i18n:_t('Authentication type')}" 
            sort="auto(userType)"/>
            <newdatasortablecolumn label="${i18n:_t('Bound resource')}" />
            <newdatasortablecolumn label="${i18n:_t('Actions')}" />
        </columns>
    </newdatasortablegrid>
    <!-- Was "@{controller.getShowCreateFormLabel}"/"@{controller.isCreateButtonDisabled}" - EL
         property names don't include the accessor prefix (should be "showCreateFormLabel"/
         "createButtonDisabled"), a second pre-existing bug independent of the @{...} binder issue. -->
    <button id="show_create_form" onClick="controller.goToCreateForm();"
        label="@load(controller.showCreateFormLabel)" sclass="create-button global-action"
        disabled="@load(controller.createButtonDisabled)">
    </button>
</window>
