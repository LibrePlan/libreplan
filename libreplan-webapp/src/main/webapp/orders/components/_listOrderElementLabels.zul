<zk>
    <zscript>
        <![CDATA[
        assignedLabelsController = self.controller;
    ]]>
    </zscript>
    <vbox apply="${assignedLabelsController}" width="100%" sclass="report-margin">
        <!-- Inherited labels -->
        <vbox width="100%">
            <panel title="${i18n:_t('Inherited labels')}" border="normal">
                <panelchildren>
                    <grid id="inheritedLabels" sclass="margin-border"
                          model="@load(assignedLabelsController.inheritedLabels)"
                          rowRenderer="@load(assignedLabelsController.inheritedLabelsRenderer)">
                        <columns>
                            <column label="${i18n:_t('Label type')}" />
                            <column label="${i18n:_t('Value')}" />
                        </columns>
                    </grid>
                </panelchildren>
            </panel>
        </vbox>

        <!-- Direct labels -->
        <vbox width="100%" sclass="report-margin">
            <panel title="${i18n:_t('Direct labels')}" border="normal">
                <panelchildren>
                    <newdatasortablegrid id="directLabels" sclass="margin-border"
                                         model="@load(assignedLabelsController.labelsModel)"
                                         rowRenderer="@load(assignedLabelsController.directLabelsRenderer)">
                        <columns>
                            <newdatasortablecolumn label="${i18n:_t('Label type')}" sort="auto(lower(type.name))"/>
                            <newdatasortablecolumn label="${i18n:_t('Value')}" />
                            <newdatasortablecolumn label="${i18n:_t('Operations')}" />
                        </columns>
                    </newdatasortablegrid>

                    <!-- Assign label -->
                    <vbox>
                        <label value="${i18n:_t('Assign Label')}" />
                        <hbox sclass="margin-border">
                            <!--
                              No model= here on purpose: LabelBandboxFinder.getAll() already
                              supplies the full label list on its own. Binding model= to
                              assignedLabelsController.allLabels used to evaluate this binder pass
                              before openWindow() ever runs (orderModel still null at that point),
                              pushing an empty list into BandboxSearch.setModel() - which also
                              calls finder.setModel(...), permanently overwriting
                              LabelBandboxFinder's cached model (it's a Spring singleton, so this
                              corrupted state was shared across every session, not just this page)
                              with that empty list before the popup was ever opened.
                            -->
                            <bandboxSearch id="bdLabels" finder="LabelBandboxFinder" />
                            <button label="${i18n:_t('Assign')}" sclass="add-button"
                                    onClick="assignedLabelsController.onAssignLabel()"
                            />
                        </hbox>
                    </vbox>

                    <!-- Create and assign label -->
                    <vbox>
                        <label value="${i18n:_t('Create and assign label')}" />
                    </vbox>
                    <hbox sclass="margin-border">
                        <autocomplete id="cbLabelType" onChange="txtLabelName.clearErrorMessage()"
                                      finder="LabelTypeFinder" buttonVisible="true" />
                        <textbox id="txtLabelName" />
                        <button id="buttonCreateAndAssign"
                                label="${i18n:_t('Create &amp; Assign')}" sclass="add-button"
                                onClick="assignedLabelsController.onCreateAndAssign()" />
                    </hbox>
                </panelchildren>
            </panel>
        </vbox>
    </vbox>
</zk>
