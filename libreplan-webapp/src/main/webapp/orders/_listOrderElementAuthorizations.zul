<vbox id="${arg.id}"
      apply="org.libreplan.web.users.OrderAuthorizationController" width="100%">

    <!-- Profiles -->
    <panel title="${i18n:_t('Profiles authorization')}" border="normal" sclass="report-margin">
        <panelchildren>
            <hbox align="center" sclass="margin-border">
                <autocomplete id="profileAutocomplete" constraint=""
                              autodrop="true" finder="ProfileFinder" />
                <checkbox id="profileReadAuthCheckbox" label="${i18n:_t('Read')}" />
                <checkbox id="profileWriteAuthCheckbox" label="${i18n:_t('Write')}" />
                <button label="${i18n:_t('Authorize')}" sclass="add-button"
                        onClick="orderAuthorizationController.addOrderAuthorization(
                        profileAutocomplete.selectedItem, profileReadAuthCheckbox.checked,
                        profileWriteAuthCheckbox.checked);"/>
            </hbox>
            <grid id="profilesAuthListing"
                  model="@load(orderAuthorizationController.profileOrderAuthorizations)"
                  rowRenderer="@load(orderAuthorizationController.orderAuthorizationRenderer)" >
                <columns sizable="true">
                    <column label="${i18n:_t('Profile name')}" />
                    <column label="${i18n:_t('Permissions')}" />
                    <column label="${i18n:_t('Actions')}" />
                </columns>
            </grid>
        </panelchildren>
    </panel>

    <!-- Users -->
    <panel title="${i18n:_t('Users authorization')}" border="normal" sclass="report-margin">
        <panelchildren>
            <hbox align="center" sclass="margin-border">
                <autocomplete id="usersAutocomplete" constraint=""
                              autodrop="true" finder="UserFinder" />
                <checkbox id="userReadAuthCheckbox" label="${i18n:_t('Read')}" />
                <checkbox id="userWriteAuthCheckbox" label="${i18n:_t('Write')}" />
                <button label="${i18n:_t('Authorize')}" sclass="add-button"
                        onClick="orderAuthorizationController.addOrderAuthorization(
                        usersAutocomplete.selectedItem, userReadAuthCheckbox.checked,
                        userWriteAuthCheckbox.checked);"/>
            </hbox>
            <grid id="usersAuthListing"
                  model="@load(orderAuthorizationController.userOrderAuthorizations)"
                  rowRenderer="@load(orderAuthorizationController.userOrderAuthorizationRenderer)">
                <columns sizable="true">
                    <column label="${i18n:_t('Profile name')}" />
                    <column label="${i18n:_t('Permissions')}" />
                    <column label="${i18n:_t('Actions')}" />
                </columns>
            </grid>
        </panelchildren>
    </panel>
</vbox>
