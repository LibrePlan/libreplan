<newdatasortablegrid id="gridMaterials"
                     model="@load(assignedMaterialsController.assignedMaterials)"
                     rowRenderer="@load(assignedMaterialsController.materialAssignmentsRenderer)">

    <columns width="100%">
        <newdatasortablecolumn label="${i18n:_t('Code')}" width="20%"/>
        <newdatasortablecolumn label="${i18n:_t('Name')}" width="15%"/>
        <newdatasortablecolumn label="${i18n:_t('Reception date')}" align="center" width="14%"/>
        <newdatasortablecolumn label="${i18n:_t('Units')}" align="center" width="11%"/>
        <newdatasortablecolumn label="${i18n:_t('Unit type')}" align="center" width="7%"/>
        <newdatasortablecolumn label="${i18n:_t('Unit price')}" align="center" width="11%"/>
        <newdatasortablecolumn label="${i18n:_t('Total price')}" align="center" width="11%" />
        <newdatasortablecolumn label="${i18n:_t('Status')}" align="center" width="13%" />
        <newdatasortablecolumn label="${i18n:_t('Op.')}" width="10%"/>
    </columns>
</newdatasortablegrid>

