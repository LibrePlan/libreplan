<window id="syncInfoWin" title="${i18n:_t('LibrePlan: Synchronization info')}" width="500px"
        sclass="job-scheduling-manual-header">

    <grid id="syncInfoGrid" mold="paging" pageSize="10"/>


    <button id="closeBtn" label="${i18n:_t('Close')}" onClick="syncInfoWin.detach()"
            sclass="cancel-button global-action"/>
</window>
