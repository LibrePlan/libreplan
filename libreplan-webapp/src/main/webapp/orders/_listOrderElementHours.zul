<vbox id="${arg.id}"
      apply="org.libreplan.web.orders.AssignedHoursToOrderElementController" width="100%">
    <!-- Direct imputation -->
    <vbox width="100%">
        <panel title="${i18n:_t('Imputed hours calculation')}">
            <panelchildren>
                <grid
                        model="@load(assignedHoursToOrderElementController.workReportLines)"
                        rowRenderer="@load(assignedHoursToOrderElementController.workReportLinesRenderer)"
                        mold="paging" pageSize="10" >
                    <columns>
                        <column label="${i18n:_t('Date')}" width="120px" />
                        <column label="${i18n:_t('Resource')}" />
                        <column label="${i18n:_t('Hours type')}" />
                        <column label="${i18n:_t('Hours')}" width="100px" />
                    </columns>
                </grid>
                <grid style="border:0px">
                    <columns>
                        <column />
                        <column width="100px" />
                    </columns>
                    <rows>
                        <row style="border-top:1px solid black">
                            <label
                                    value="${i18n:_t('Sum of direct imputed hours')}" />
                            <label
                                    value="@load(assignedHoursToOrderElementController.totalAssignedDirectEffort)" />
                        </row>
                        <row>
                            <label
                                    value="${i18n:_t('Sum of imputed hours in children tasks')}" />
                            <label id="totalIDC"
                                   value="@load(assignedHoursToOrderElementController.effortChildren)" />
                        </row>
                        <row
                                style="border-top:1px solid black; font-weight: bold;">
                            <label value="${i18n:_t('Total hours')}"
                                   style="font-weight: bold" />
                            <label id="addtotal"
                                   value="@load(assignedHoursToOrderElementController.totalAssignedEffort)"
                                   style="font-weight: bold" />
                        </row>
                    </rows>
                </grid>
            </panelchildren>
        </panel>
        <panel title="${i18n:_t('Imputed expenses')}">
            <panelchildren>
                <separator bar="false" spacing="10px" orient="horizontal"/>
                <grid id="listExpenses"  mold="paging" pageSize="10"
                      model="@load(assignedHoursToOrderElementController.expenseSheetLines)"
                      rowRenderer="@load(assignedHoursToOrderElementController.expenseSheetLinesRenderer)"
                      sclass="clickable-rows">
                    <columns sizable="true">
                        <column label="${i18n:_t('Date')}" width="120px"/>
                        <column label="${i18n:_t('Concept')}"/>
                        <column label="${i18n:_t('Resource')}"/>
                        <column label="${i18n:_t('Value')}" width="100px"/>
                    </columns>
                </grid>
                <grid style="border:0px">
                    <columns>
                        <column />
                        <column width="100px" />
                    </columns>
                    <rows>
                        <row style="border-top:1px solid black">
                            <label
                                    value="${i18n:_t('Sum of direct expenses')}" />
                            <hbox>
                                <label
                                        value="@load(assignedHoursToOrderElementController.totalDirectExpenses)" />
                                <label value="@load(assignedHoursToOrderElementController.currencySymbol)" />
                            </hbox>
                        </row>
                        <row>
                            <label
                                    value="${i18n:_t('Sum of expenses imputed in children tasks')}" />
                            <hbox>
                                <label id="totalIDE"
                                       value="@load(assignedHoursToOrderElementController.totalIndirectExpenses)" />
                                <label value="@load(assignedHoursToOrderElementController.currencySymbol)" />
                            </hbox>
                        </row>
                        <row
                                style="border-top:1px solid black; font-weight: bold;">
                            <label value="${i18n:_t('Total expenses')}"
                                   style="font-weight: bold" />
                            <hbox>
                                <label style="font-weight: bold"
                                       value="@load(assignedHoursToOrderElementController.totalExpenses)"/>
                                <label value="@load(assignedHoursToOrderElementController.currencySymbol)" />
                            </hbox>
                        </row>
                    </rows>
                </grid>
            </panelchildren>
        </panel>
    </vbox>

    <separator spacing="5px" orient="horizontal" />

    <!-- Hours consumed -->
    <vbox width="100%">
        <panel
                title="${i18n:_t('Percentage of estimated budget hours / hours consumed')}">
            <panelchildren>
                <grid>
                    <columns>
                        <column />
                        <column />
                    </columns>
                    <rows>
                        <row>
                            <grid>
                                <columns>
                                    <column width="200px" />
                                    <column width="200px" />
                                </columns>
                                <rows>
                                    <row>
                                        <label
                                                value="${i18n:_t('Budget hours')}:" />
                                        <label
                                                value="@load(assignedHoursToOrderElementController.estimatedEffort)" />
                                    </row>
                                    <row>
                                        <label
                                                value="${i18n:_t('Imputed hours')}:" />
                                        <label
                                                value="@load(assignedHoursToOrderElementController.totalAssignedEffort)" />
                                    </row>
                                </rows>
                            </grid>
                            <hbox id="Percentage">
                                <label
                                        value="@load(assignedHoursToOrderElementController.progressWork)" />
                                <label value="${i18n:_t('%')}" />
                                <progressmeter id="hoursProgressBar" />
                                <progressmeter id="exceedHoursProgressBar"
                                               style="background:red ; border:1px solid red"
                                               value="0" />
                            </hbox>
                        </row>
                    </rows>
                </grid>
            </panelchildren>
        </panel>
    </vbox>

    <!-- Money consumed -->
    <vbox width="100%">
        <panel
                title="${i18n:_t('Percentage of estimated budget in money / money spent')}">
            <panelchildren>
                <grid>
                    <columns>
                        <column />
                        <column />
                    </columns>
                    <rows sclass="remove-detailrow-background">
                        <row>
                            <grid>
                                <columns>
                                    <column width="40px"/>
                                    <column width="200px"/>
                                    <column width="199px"/>
                                </columns>
                                <rows>
                                    <row>
                                        <detailrow open="false">
                                            <grid>
                                                <columns>
                                                    <column width="200px" />
                                                    <column align="right"/>
                                                </columns>
                                                <rows>
                                                    <row>
                                                        <label value="${i18n:_t('Resources budget')}:" />
                                                        <hbox sclass="move-to-right-in-table">
                                                            <label value="@load(assignedHoursToOrderElementController.resourcesBudget)" />
                                                            <label value="@load(assignedHoursToOrderElementController.currencySymbol)" />
                                                        </hbox>
                                                    </row>
                                                    <row>
                                                        <label value="${i18n:_t('Expenses budget')}:" />
                                                        <hbox sclass="move-to-right-in-table">
                                                            <label value="@load(assignedHoursToOrderElementController.budget)" />
                                                            <label value="@load(assignedHoursToOrderElementController.currencySymbol)" />
                                                        </hbox>
                                                    </row>
                                                </rows>
                                            </grid>
                                        </detailrow>
                                        <label
                                                value="${i18n:_t('Total calculated budget')}:" />
                                        <hbox sclass="move-to-right-in-table">
                                            <label value="@load(assignedHoursToOrderElementController.calculatedBudget)" />
                                            <label value="@load(assignedHoursToOrderElementController.currencySymbol)" />
                                        </hbox>
                                    </row>


                                    <row>
                                        <detailrow open="false">
                                            <grid>
                                                <columns>
                                                    <column width="200px" />
                                                    <column align="right"/>
                                                </columns>
                                                <rows>
                                                    <row>
                                                        <label value="${i18n:_t('Hours cost')}:" />
                                                        <hbox sclass="move-to-right-in-table">
                                                            <label value="@load(assignedHoursToOrderElementController.costOfHours)" />
                                                            <label value="@load(assignedHoursToOrderElementController.currencySymbol)" />
                                                        </hbox>
                                                    </row>
                                                    <row>
                                                        <label value="${i18n:_t('Expenses cost')}:" />
                                                        <hbox sclass="move-to-right-in-table">
                                                            <label value="@load(assignedHoursToOrderElementController.costOfExpenses)" />
                                                            <label value="@load(assignedHoursToOrderElementController.currencySymbol)" />
                                                        </hbox>
                                                    </row>
                                                </rows>
                                            </grid>
                                        </detailrow>
                                        <label
                                                value="${i18n:_t('Money spent')}:" />
                                        <hbox sclass="move-to-right-in-table">
                                            <label
                                                    value="@load(assignedHoursToOrderElementController.moneyCost)" />
                                            <label value="@load(assignedHoursToOrderElementController.currencySymbol)" />
                                        </hbox>
                                    </row>
                                </rows>
                            </grid>
                            <hbox>
                                <separator bar="false" spacing="10px" orient="vertical"/>
                                <label
                                        value="@load(assignedHoursToOrderElementController.moneyCostPercentage)" />
                                <label value="${i18n:_t('%')}" />
                                <progressmeter id="moneyCostProgressBar" />
                                <progressmeter id="exceedMoneyCostProgressBar"
                                               style="background:red ; border:1px solid red"
                                               value="0" />
                            </hbox>
                        </row>
                    </rows>
                </grid>
            </panelchildren>
        </panel>
    </vbox>
    <!-- Script for aligning money values and currency symbols to right -->
    <script>
        zk.afterMount(function() {
            $('.move-to-right-in-table').parent().css({'float':'right'});
        });
    </script>
</vbox>