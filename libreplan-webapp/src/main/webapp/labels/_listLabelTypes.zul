<window id="${arg.id}" title="${i18n:_t('Label Types List')}">
    <newdatasortablegrid id="labelTypes" model="@load(controller.labelTypes)"
        rowRenderer="@load(controller.labelTypeRenderer)"
        mold="paging" pageSize="10" sclass="clickable-rows">
        <columns>
            <newdatasortablecolumn label="${i18n:_t('Name')}" sort="auto(lower(name))" sortDirection="ascending" />
            <newdatasortablecolumn label="${i18n:_t('Code')}"/>
            <newdatasortablecolumn label="${i18n:_t('Operations')}" />
        </columns>
    </newdatasortablegrid>
    <button label="${i18n:_t('Create')}" onClick="controller.goToCreateForm()"
        sclass="create-button global-action"/>
</window>
