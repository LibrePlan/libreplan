<window id="${arg.id}">
    <caption id="caption" sclass="caption-title" />
    <tabbox>
        <tabs>
            <tab label="${i18n:_t('Edit')}"/>
        </tabs>
        <tabpanels>
            <tabpanel>
                <grid>
                    <columns>
                        <column width="200px" />
                        <column />
                    </columns>

                    <rows>
                        <row>
                            <label value="${i18n:_t('Code')}:" />
                            <!-- visible was "@{controller.editable}" - controller.editable never
                                 existed (no getEditable()/isEditable() anywhere in this
                                 controller), a pre-existing dead reference independent of the
                                 @{...} binder issue. "updatable" matches the intent (hide the code
                                 field for non-editable/predefined types) and the same property
                                 already used for this purpose in exceptionDayTypeRenderer. -->
                            <hbox>
                                <textbox id="code" width="300px"
                                         value="@load(controller.exceptionDayType.code) @save(controller.exceptionDayType.code)"
                                         visible = "@load(controller.exceptionDayType.updatable)"
                                         disabled="@load(controller.exceptionDayTypeCodeAutogenerated)"
                                         constraint = "no empty:${i18n:_t('cannot be empty')}"/>

                                <checkbox id="generateCode"
                                          label="${i18n:_t('Generate code')}"
                                          onCheck="controller.onCheckGenerateCode(event)"
                                          checked="@load(controller.exceptionDayTypeCodeAutogenerated) @save(controller.exceptionDayTypeCodeAutogenerated)"/>
                            </hbox>
                        </row>

                        <row>
                            <label value="${i18n:_t('Name')}"/>
                            <textbox id="tbName" width="300px"
                                     value="@load(controller.exceptionDayType.name) @save(controller.exceptionDayType.name)"
                                     constraint="no empty:${i18n:_t('cannot be empty')}"
                                     onBlur="controller.updateWindowTitle()" />
                        </row>

                        <row>
                            <label value="${i18n:_t('Color')}" />
                            <hbox align="pack">
                                <listbox id="colorsListbox" mold="select"
                                         model="@load(controller.colors)"
                                         selectedItem="@load(controller.exceptionDayType.color) @save(controller.exceptionDayType.color)"
                                         itemRenderer="@load(controller.colorsRenderer)"
                                         onSelect="controller.reloadSampleColors()" />

                                <div id="colorSampleOwn" sclass="color-sample"
                                     style="@load(controller.styleColorOwnException)" />

                                <label value="${i18n:_t('Own exception')}" />

                                <div id="colorSampleDerived" sclass="color-sample"
                                     style="@load(controller.styleColorDerivedException)" />

                                <label value="${i18n:_t('Inherited exception')}" />
                            </hbox>
                        </row>

                        <row>
                            <label value="${i18n:_t('Standard Effort')}" />
                            <effortDurationPicker id="standardEffort" />
                        </row>

                        <row>
                            <label value="${i18n:_t('Extra Effort')}" />
                            <hbox>
                                <effortDurationPicker id="extraEffort" />
                                <checkbox id="overAssignable" label="${i18n:_t('Infinitely Over Assignable')}"/>
                            </hbox>
                        </row>
                    </rows>
                </grid>
            </tabpanel>
        </tabpanels>
    </tabbox>

    <!-- Control buttons -->
    <button onClick="controller.saveAndExit()" autodisable="self"
            label="${i18n:_t('Save')}"
            sclass="save-button global-action"/>
    <button onClick="controller.saveAndContinue()"
            label="${i18n:_t('Save and Continue')}"
            sclass="save-button global-action"/>
    <button onClick="controller.cancelForm()"
            label="${i18n:_t('Cancel')}"
            sclass="cancel-button global-action"/>
</window>
