<window id="editWindow">
    <caption id="caption" sclass="caption-title" />
    <grid id="issueLogGrid">
        <columns>
            <column width="160px" />
            <column/>
        </columns>
        <rows>
            <row>
                <label value="${i18n:_t('Issue number')}" />
                <textbox id="issueNumberTextBox" width="636px"
                         value="@load(issueLogController.issueLog.code)" disabled="true"/>
            </row>
            <row>
                <label value="${i18n:_t('Project')}" />
                <!-- No @save here: bdProjectIssueLog's ON_SELECT/ON_OK listeners registered in
                     initializeOrderComponent() already save the selection back manually. -->
                <bandboxSearch id="bdProjectIssueLog" widthBandbox="636px" widthListbox="636px"
                               constraint="no empty:${i18n:_t('cannot be empty')}"
                               finder="OrderBandboxFinder"
                               model="@load(issueLogController.orders)"
                               selectedElement="@load(issueLogController.order)"/>
            </row>
            <row>
                <label value="${i18n:_t('Type and status')}" />
                <grid>
                    <columns>
                        <column width="80px"/>
                        <column width="248px"/>
                        <column width="60px"/>
                        <column width="248px"/>
                    </columns>
                    <rows>
                        <row>
                            <label value="${i18n:_t('Type')}" />
                            <listbox id="listIssueLogType" mold="select" rows="1" width="237px"
                                     model="@load(issueLogController.issueTypeEnum)"
                                     selectedItem="@load(issueLogController.issueLog.type) @save(issueLogController.issueLog.type)"
                                     itemRenderer="@load(issueLogController.issueTypeRenderer)"
                                     onSelect="issueLogController.updateStatusList(true)"/>

                            <label value="${i18n:_t('Status')}" />
                            <listbox id="listIssueLogStatus" mold="select" rows="1" width="237px">

                            </listbox>
                        </row>
                    </rows>
                </grid>
            </row>

            <row>
                <label value="${i18n:_t('Creation info')}" />
                <grid>
                    <columns>
                        <column width="80px"/>
                        <column width="146px"/>
                        <column width="80px"/>
                        <column width="330px"/>
                    </columns>
                    <rows>
                        <row>
                            <label value="${i18n:_t('Date raised')}" />
                            <datebox id="dateRaisedBox" width="131px"
                                     constraint="no empty:${i18n:_t('cannot be empty')}"
                                     value="@load(issueLogController.dateRaised) @save(issueLogController.dateRaised)" />

                            <label value="${i18n:_t('Created by')}" />
                            <!-- No @save: initializeUserComponent()'s ON_SELECT/ON_OK listeners
                                 already save the selection back manually. -->
                            <bandboxSearch id="bdUserIssueLog" widthBandbox="315px" widthListbox="340px"
                                           finder="UserBandboxFinder"
                                           model="@load(issueLogController.users)"
                                           selectedElement="@load(issueLogController.issueLog.createdBy)"/>
                        </row>
                    </rows>
                </grid>
            </row>
            <row>
                <label value="${i18n:_t('Description')}" />
                <textbox id="descriptionNameTextBox" width="636px" rows="4"
                         value="@load(issueLogController.issueLog.description) @save(issueLogController.issueLog.description)" maxlength="1024"/>
            </row>
            <row>
                <label value="${i18n:_t('Categories')}" />
                <grid>
                    <columns>
                        <column width="150px"/>
                        <column width="168px"/>
                        <column width="150px"/>
                        <column width="168px"/>
                    </columns>
                    <rows>
                        <row>
                            <label value="${i18n:_t('Priority')}" />
                            <listbox id="listIssueLogPriority" mold="select" rows="1" width="157px"
                                     model="@load(issueLogController.lowMediumHighEnum)"
                                     selectedItem="@load(issueLogController.issueLog.priority) @save(issueLogController.issueLog.priority)"
                                     itemRenderer="@load(issueLogController.lowMediumHighEnumRenderer)" />

                            <label value="${i18n:_t('Severity')}"/>
                            <listbox id="listIssueLogSeverity" mold="select" rows="1" width="157px"
                                     model="@load(issueLogController.lowMediumHighEnum)"
                                     selectedItem="@load(issueLogController.issueLog.severity) @save(issueLogController.issueLog.severity)"
                                     itemRenderer="@load(issueLogController.lowMediumHighEnumRenderer)" />
                        </row>
                    </rows>
                </grid>
            </row>
            <row>
                <label value="${i18n:_t('Assigned to')}" />
                <textbox id="assignedToTextBox" width="636px"
                         value="@load(issueLogController.issueLog.assignedTo) @save(issueLogController.issueLog.assignedTo)" maxlength="512"/>
            </row>
            <row>
                <label value="${i18n:_t('Timing')}" />
                <hbox>
                    <grid id="timing">
                        <columns>
                            <column width="150px"/>
                            <column width="168px"/>
                            <column width="150px"/>
                            <column width="168px"/>
                        </columns>
                        <rows>
                            <row>
                                <label value="${i18n:_t('Deadline')}"/>
                                <datebox id="deadline" width="153px"
                                         value="@load(issueLogController.deadline) @save(issueLogController.deadline)" />

                                <label value="${i18n:_t('Date resolved')}" />
                                <datebox id="dateResolved" width="153px"
                                         value="@load(issueLogController.dateResolved) @save(issueLogController.dateResolved)" />
                            </row>
                        </rows>
                    </grid>
                </hbox>
            </row>
            <row>
                <label value="${i18n:_t('Notes')}" />
                <textbox value="@load(issueLogController.issueLog.notes) @save(issueLogController.issueLog.notes)" width="636px" rows="8" multiline="true"
                         maxlength="1024"/>
            </row>
        </rows>
    </grid>
    <!-- Control buttons -->
    <button onClick="issueLogController.saveAndExit()"
            label="${i18n:_t('Save')}"
            sclass="save-button global-action" />
    <button onClick="issueLogController.saveAndContinue()"
            label="${i18n:_t('Save and Continue')}"
            sclass="save-button global-action" />
    <button onClick="issueLogController.cancelForm()"
            label="${i18n:_t('Cancel')}"
            sclass="cancel-button global-action" />
</window>
