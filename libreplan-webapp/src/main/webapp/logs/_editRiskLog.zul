<window id="editWindow" height="100%">
    <caption id="caption" sclass="caption-title" />
    <grid id="riskLogGrid" >
        <columns>
            <column width="160px" />
            <column/>
        </columns>
        <rows>
            <row>
                <label value="${i18n:_t('Code')}" />
                <textbox id="riskNumberTextBox" width="636px"
                         value="@load(riskLogController.riskLog.code)" disabled="true"/>
            </row>

            <row>
                <label value="${i18n:_t('Project')}" />
                <!-- No @save here: initializeOrderComponent()'s ON_SELECT/ON_OK listeners already
                     save the selection back manually. -->
                <bandboxSearch id="bdProjectRiskLog" widthBandbox="636px" widthListbox="636px"
                               constraint="no empty:${i18n:_t('cannot be empty')}"
                               finder="OrderBandboxFinder"
                               model="@load(riskLogController.orders)"
                               selectedElement="@load(riskLogController.order)"/>
            </row>

            <row>
                <label value="${i18n:_t('Status')}" />
                <textbox value="@load(riskLogController.riskLog.status) @save(riskLogController.riskLog.status)" width="636px" rows="1" multiline="false"
                         maxlength="512"/>
            </row>

            <row>
                <label value="${i18n:_t('Estimations')}" />
                <grid>
                    <columns>
                        <column width="110px"/>
                        <column width="133px"/>
                        <column width="90px"/>
                        <column width="133px"/>
                        <column width="80px"/>
                        <column width="90px"/>
                    </columns>
                    <rows>
                        <row>
                            <label value="${i18n:_t('Probability')}" />
                            <listbox id="listRiskLogProbability" mold="select" rows="1" width="122px"
                                     model="@load(riskLogController.lowMediumHighEnums)"
                                     selectedItem="@load(riskLogController.riskLog.probability) @save(riskLogController.riskLog.probability)"
                                     itemRenderer="@load(riskLogController.lowMediumHighEnumRenderer)"
                                     onSelect="riskLogController.setUpdateScore()"/>

                            <label value="${i18n:_t('Impact')}" />
                            <listbox id="listRiskLogImpact" mold="select" rows="1" width="122px"
                                     model="@load(riskLogController.lowMediumHighEnums)"
                                     selectedItem="@load(riskLogController.riskLog.impact) @save(riskLogController.riskLog.impact)"
                                     itemRenderer="@load(riskLogController.lowMediumHighEnumRenderer)"
                                     onSelect="riskLogController.setUpdateScore()" />

                            <label value="${i18n:_t('Risk score')}" />
                            <textbox id="riskScore" value="@load(riskLogController.riskLog.riskScore)"
                                     width="75px"
                                     rows="1"
                                     disabled="true" />
                        </row>
                    </rows>
                </grid>
            </row>
            <row>
                <label value="${i18n:_t('Creation info')}" />
                <grid>
                    <columns>
                        <column width="80px"/>
                        <column width="146px"/>
                        <column width="80px"/>
                        <column width="330px"/>
                    </columns>
                    <rows>
                        <row>
                            <label value="${i18n:_t('Date created')}" />
                            <datebox id="dateCreatedBox" width="131px"
                                     constraint="no empty:${i18n:_t('cannot be empty')}"
                                     value="@load(riskLogController.dateCreated) @save(riskLogController.dateCreated)" />

                            <label value="${i18n:_t('Created by')}" />
                            <!-- No @save: initializeUserComponent()'s ON_SELECT/ON_OK listeners
                                 already save the selection back manually. -->
                            <bandboxSearch id="bdUserRiskLog" widthBandbox="315px" widthListbox="340px"
                                           finder="UserBandboxFinder"
                                           model="@load(riskLogController.users)"
                                           selectedElement="@load(riskLogController.riskLog.createdBy)"/>
                        </row>
                    </rows>
                </grid>
            </row>
            <row>
                <label value="${i18n:_t('Description')}" />
                <textbox id="descriptionNameTextBox" width="636px" rows="3"
                         value="@load(riskLogController.riskLog.description) @save(riskLogController.riskLog.description)" maxlength="1024"/>
            </row>
            <row>
                <label value="${i18n:_t('Counter measures (CM)')}" />
                <textbox id="counterMeasuresTextbox" width="636px" rows="3"
                         value="@load(riskLogController.riskLog.counterMeasures) @save(riskLogController.riskLog.counterMeasures)" maxlength="1024"/>
            </row>
            <row>
                <label value="${i18n:_t('Risk Score After CM')}" />
                <listbox id="listRiskScores" mold="select" rows="1" width="135px"
                         model="@load(riskLogController.riskScoreStatesEnums)"
                         selectedItem="@load(riskLogController.riskLog.scoreAfterCM) @save(riskLogController.riskLog.scoreAfterCM)"
                         itemRenderer="@load(riskLogController.riskScoreStatesEnumRenderer)" />
            </row>
            <row>
                <label value="${i18n:_t('Contingency')}" />
                <textbox id="contingencyBox" width="636px" rows="3"
                         value="@load(riskLogController.riskLog.contingency) @save(riskLogController.riskLog.contingency)" maxlength="1024"/>
            </row>
            <row>
                <label value="${i18n:_t('Prevention')}" />
                <grid>
                    <columns>
                        <column width="80px"/>
                        <column width="146px"/>
                        <column width="80px"/>
                        <column width="330px"/>
                    </columns>
                    <rows>
                        <row>

                            <label value="${i18n:_t('Action When')}" />
                            <datebox id="actionWhenDateBox" width="131px"
                                     constraint="no empty:${i18n:_t('cannot be empty')}"
                                     value="@load(riskLogController.actionWhen) @save(riskLogController.actionWhen)" />

                            <label value="${i18n:_t('Responsible')}" />
                            <textbox id="responsibleBox" width="315px" rows="1"
                                     value="@load(riskLogController.riskLog.responsible) @save(riskLogController.riskLog.responsible)" maxlength="512"/>
                        </row>
                    </rows>
                </grid>
            </row>
            <row>
                <label value="${i18n:_t('Notes')}" />
                <textbox value="@load(riskLogController.riskLog.notes) @save(riskLogController.riskLog.notes)" width="636px" rows="5" multiline="true"
                         maxlength="1024"/>
            </row>
        </rows>
    </grid>
    <!-- Control buttons -->
    <button onClick="riskLogController.saveAndExit()"
            label="${i18n:_t('Save')}"
            sclass="save-button global-action" />
    <button onClick="riskLogController.saveAndContinue()"
            label="${i18n:_t('Save and Continue')}"
            sclass="save-button global-action" />
    <button onClick="riskLogController.cancelForm()"
            label="${i18n:_t('Cancel')}"
            sclass="cancel-button global-action" />
</window>