<?component name="criterionsTree" inline="true" macroURI="_criterionsTree.zul"?>

<window id="${arg.id}">
    <caption id="caption" sclass="caption-title" />
    <tabbox>
        <tabs>
            <tab label="${i18n:_t('Edit')}" width="850"></tab>
        </tabs>
        <tabpanels>
            <tabpanel>
                <grid>
                    <columns>
                        <column width="200px"/>
                        <column/>
                    </columns>
                    <rows>
                        <row>
                            <label value="${i18n:_t('Name')}" />
                            <textbox width="390px"
                                value="@load(controller.criterionType.name) @save(controller.criterionType.name)"
                                onBlur="controller.updateWindowTitle()" />
                        </row>
                        <row>
                            <label value="${i18n:_t('Type')}" />
                            <combobox id="resourceCombobox" autodrop="true"
                                constraint="no empty:${i18n:_t('cannot be empty')}"
                                onChange="controller.setResource(self.selectedItem)" />
                        </row>
                        <row>
                            <label value="${i18n:_t('Multiple values per resource')}"
                                tooltiptext="${i18n:_t('Allow multiple values of this type of criterion in the same period of time')}"/>
                            <checkbox checked="@load(controller.criterionType.allowSimultaneousCriterionsPerResource) @save(controller.criterionType.allowSimultaneousCriterionsPerResource)"/>
                        </row>
                        <row>
                            <label value="${i18n:_t('Hierarchy')}" />
                            <checkbox id="cbHierarchy"
                                    checked="@load(controller.criterionTypeAllowHierarchy) @save(controller.criterionTypeAllowHierarchy)"
                                    onCheck="controller.confirmDisabledHierarchy()" />
                        </row>
                        <row>
                            <label value="${i18n:_t('Enabled')}" />
                            <checkbox checked="@load(controller.criterionType.enabled) @save(controller.criterionType.enabled)"
                                onCheck="controller.changeEnabled(self);"/>
                        </row>

                        <row>
                            <label value="${i18n:_t('Description')}" />
                            <textbox value="@load(controller.criterionType.description) @save(controller.criterionType.description)" rows="2" width="390px"/>
                        </row>
                        <row>
                            <label value="${i18n:_t('Code')}" />
                            <hbox>
                                <textbox width="250px"
                                    value="@load(controller.criterionType.code) @save(controller.criterionType.code)"
                                    constraint="no empty:${i18n:_t('cannot be empty')}"
                                    disabled="@load(controller.criterionTypeCodeAutogenerated)" />
                                <checkbox id="generateCode" label="${i18n:_t('Generate code')}"
                                    onCheck="controller.onCheckGenerateCode(event)"
                                    checked="@load(controller.criterionTypeCodeAutogenerated) @save(controller.criterionTypeCodeAutogenerated)" />
                            </hbox>
                        </row>
                    </rows>
                </grid>
                <separator bar="false" height="10px" orient="vertical"/>
                <criterionsTree/>
            </tabpanel>
        </tabpanels>
    </tabbox>
    <hbox>
        <button id="save" onClick="controller.saveAndExit();" autodisable="self"
            label="${i18n:_t('Save')}" sclass="save-button global-action" />
        <button id="save_and_continue" onClick="controller.saveAndContinue();"
            label="${i18n:_t('Save &amp; Continue')}" sclass="saveandcontinue-button global-action"/>
        <button id="close" onClick="controller.cancelForm();"
            label="${i18n:_t('Cancel')}" sclass="cancel-button global-action"/>
    </hbox>
</window>
