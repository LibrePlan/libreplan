<window id="listWindow" title="${i18n:_t('Criterion Types List')}">
<newdatasortablegrid model="@load(controller.criterionTypes)"
    rowRenderer="@load(controller.criterionTypeRenderer)" sclass="clickable-rows">
   <columns>
        <newdatasortablecolumn label="${i18n:_t('Name')}" sort="auto(lower(name))" sortDirection="ascending" />
        <newdatasortablecolumn label="${i18n:_t('Code')}" />
        <newdatasortablecolumn label="${i18n:_t('Type')}" />
        <newdatasortablecolumn width="60px" label="${i18n:_t('Enabled')}"/>
        <newdatasortablecolumn width="200px" label="${i18n:_t('Operations')}"/>
    </columns>
</newdatasortablegrid>
<button id="show_create_form" onClick="controller.goToCreateForm();" label="${i18n:_t('Create')}"
    sclass="create-button global-action">
</button>
</window>
