<?component name="filter" inline="true" macroURI="../search/_resourceFilter.zul"?>
<window id="${arg.top_id}" title="${i18n:_t('Virtual Workers Groups List')}">
     <separator bar="false" spacing="5px" orient="horizontal"/>

    <div style="text-align: right;">
        <filter id="filter"/>
    </div>

    <separator bar="false" spacing="5px" orient="horizontal"/>

    <!-- rowRenderer set imperatively via getVirtualWorkersRenderer() instead of a ZUML "each"
         template - self="@{each=...}" only ever clones the row's FIRST child under this app's
         AnnotateBinder. -->
    <newdatasortablegrid id="listing" model="@load(controller.virtualWorkers)" mold="paging"
        rowRenderer="@load(controller.virtualWorkersRenderer)"
        pageSize="10" sclass="clickable-rows">
        <columns>
            <newdatasortablecolumn label="${i18n:_t('Name')}" sort="auto(lower(name))" sortDirection="ascending"/>
            <newdatasortablecolumn label="${i18n:_t('Capacity')}" sort="auto(capacity)" />
            <newdatasortablecolumn label="${i18n:_t('Observations')}" sort="auto(observations)" />
            <newdatasortablecolumn label="${i18n:_t('Operations')}" />
        </columns>
    </newdatasortablegrid>
    <button id="show_create_form" onClick="controller.goToCreateVirtualWorkerForm();"
        label="${i18n:_t('Create Virtual Worker')}" sclass="create-button global-action">
    </button>
</window>
