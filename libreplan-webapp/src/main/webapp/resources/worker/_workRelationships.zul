<window id="${arg.top_id}"
    apply="${controller.workRelationshipsController}">
    <grid id="history"
        model="@load(controller.criterionSatisfactions)"
        rowRenderer="@load(controller.criterionSatisfactionsRenderer)"
        mold="paging" pageSize="10">
        <columns>
            <column label="${i18n:_t('Starting date')}" width="150px"/>
            <column label="${i18n:_t('Ending date')}" width="150px"/>
            <column label="${i18n:_t('Relationship')}"/>
            <column label="${i18n:_t('Operations')}"/>
        </columns>
      </grid>
    <button label="${i18n:_t('New entry')}"
        onClick="controller.goToAddWorkRelationshipForm()">
    </button>
</window>
