<vbox id="localizationsContainer" style="padding: 10px">
    <hbox>

        <vbox>
            <label sclass="subtitulo" value="${i18n:_t('Assigned locations')}" />
            <listbox id="activeSatisfactions" mold="paging"
                     model="@load(controller.localizations.activeSatisfactions)"
                     itemRenderer="@load(controller.localizations.activeSatisfactionsRenderer)"
                     height="200px" multiple="true" checkmark="true">
                <listhead>
                    <listheader label="${i18n:_t('Group')}"
                                sort="auto(criterion.name)"/>
                    <listheader label="${i18n:_t('Starting date')}"
                                sort="auto(startDate)" />
                </listhead>
            </listbox>
        </vbox>
        <vbox style="margin-top:80px">
            <button id="unassignButton" label="&gt;&gt;"/>
            <button id="assignButton" label="&lt;&lt;"/>
        </vbox>

        <vbox>
            <label sclass="subtitulo" value="${i18n:_t('Non-assigned locations')}" />
            <listbox id="criterionsNotAssigned" mold="paging"
                     model="@load(controller.localizations.criterionsNotAssigned)"
                     itemRenderer="@load(controller.localizations.criterionsNotAssignedRenderer)"
                     height="200px" multiple="true" checkmark="true">
                <listhead>
                    <listheader label="${i18n:_t('Group')}"
                                sort="auto(name)"/>
                </listhead>
            </listbox>
        </vbox>
    </hbox>


    <label sclass="subtitulo" value="${i18n:_t('Log')}" />
    <grid id="listing" model="@load(controller.localizations.localizationsHistory)"
          rowRenderer="@load(controller.localizations.localizationsHistoryRenderer)"
          mold="paging" pageSize="10">
        <columns>
            <column label="${i18n:_t('Group')}" sort="auto(criterion.name)" />
            <column label="${i18n:_t('Starting date')}" sort="auto(startDate)" />
            <column label="${i18n:_t('Ending date')}" sort="auto(endDate)" />
        </columns>
    </grid>
</vbox>
