<?component name="calendarEdition" inline="true" macroURI="/calendars/_edition.zul"?>
<?component name="createNewVersion" inline="true" macroURI="/calendars/_createNewVersion.zul"?>

<vbox id="resourceCalendarContainer" width="100%">

<div visible="@load(controller.calendarNull)">

<hbox>
    <label value="${i18n:_t('Select parent calendar')}" />
    <combobox id="createDerivedCalendar"
        model="@load(controller.baseCalendars)"
        itemRenderer="@load(controller.baseCalendarsComboitemRenderer)" />
</hbox>

</div>

<!-- Control buttons calendar -->
<div visible="@load(controller.calendarNotNull)">
    <calendarEdition top_id="editCalendarWindow" title="${i18n:_t('Edit Calendar')}"
        save_button_label="${i18n:_t('Save changes')}"
        save_button_visible="false"
        cancel_button_label="${i18n:_t('Remove calendar')}" />
    <createNewVersion />
</div>

</vbox>
