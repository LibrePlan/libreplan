<window id="${arg.id}" title="${i18n:_t('Quality Forms List')}">
    <div style="text-align: right;">
        <hbox align="end" sclass="label-middle">
            <!-- Filter by name -->
            <label value="${i18n:_t('Filter quality forms by')}:"/>
            <label value="${i18n:_t('name')}"/>
            <textbox value="" id="txtFilter"/>
            <button label="${i18n:_t('Filter')}" onClick="controller.onApplyFilter(event)" sclass="add-button"/>
        </hbox>
    </div>

    <separator bar="false" spacing="5px" orient="vertical"/>

    <grid id="qualityFormsList" model="@load(controller.qualityForms)"
          rowRenderer="@load(controller.qualityFormRenderer)" sclass="clickable-rows"
          mold="paging" pageSize="10">
        <columns>
            <column label="${i18n:_t('Name')}" sort="auto(lower(name))" sortDirection="ascending" />
            <column label="${i18n:_t('Description')}" />
            <column label="${i18n:_t('Operations')}" width="120px"/>
        </columns>
    </grid>
    <button label="${i18n:_t('Create')}"
            onClick="controller.goToCreateForm()"
            sclass="create-button global-action"/>
</window>
