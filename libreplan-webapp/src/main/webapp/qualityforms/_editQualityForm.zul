<window id="${arg.id}" visible="false">
    <caption id="caption" sclass="caption-title" />
    <!--  Messages for user -->
    <vbox id="messagesContainer"/>

    <tabbox>
        <tabs>
            <tab label="${i18n:_t('Quality form')}"/>
        </tabs>
        <tabpanels>
            <tabpanel>
                <!--  Name qualityForm -->
                <vbox style="margin-bottom: 5px" width="100%">
                    <grid>
                        <columns>
                            <column width="250px" />
                            <column />
                        </columns>
                        <rows>
                            <row>
                                <label value="${i18n:_t('Name')}" />
                                <textbox id="qualityFormName"
                                         width="500px" value="@load(controller.qualityForm.name) @save(controller.qualityForm.name)"
                                         constraint="@load(controller.checkConstraintUniqueQualityFormName())"
                                         onBlur="controller.updateWindowTitle()" sclass="focus-element" />
                            </row>
                            <row>
                                <label value="${i18n:_t('Description')}" />
                                <textbox id="qualityFormDescription"
                                         rows="3" width="500px"
                                         value="@load(controller.qualityForm.description) @save(controller.qualityForm.description)"/>
                            </row>
                            <row>
                                <hbox>
                                    <label value="${i18n:_t('Quality form type')}" />
                                    <image height="15px" src="/common/img/axuda.gif" tooltip="quality-forms-popup" />
                                </hbox>
                                <listbox id="listQualityFormTypes" mold="select" rows="1"
                                         model="@load(controller.qualityFormTypes)"
                                         onSelect="controller.changeQualityFormType();"
                                         selectedItem="@load(controller.qualityForm.qualityFormType) @save(controller.qualityForm.qualityFormType)"
                                         itemRenderer="org.libreplan.web.common.EnumsListitemRenderer"/>
                            </row>
                            <row>
                                <label value="${i18n:_t('Report progress')}" />
                                <checkbox id="checkBoxReportProgress" checked="@load(controller.qualityFormReportAdvance) @save(controller.qualityFormReportAdvance)" />
                            </row>
                        </rows>
                    </grid>
                </vbox>

                <!-- Quality form items list -->
                <panel title="${i18n:_t('Quality form items list')}" border="normal">
                    <panelchildren>
                        <hbox pack="center">
                            <button label="${i18n:_t('New quality form item')}" sclass="add-button"
                                    onClick="controller.createQualityFormItem()" />
                        </hbox>
                        <grid id="gridQualityFormItems"
                              model="@load(controller.qualityFormItems)"
                              rowRenderer="@load(controller.qualityFormItemRenderer)">
                            <columns sizable="true">
                                <column label="${i18n:_t('Name')}"/>
                                <column label="${i18n:_t('Position')}" align="center" width="120px"
                                        sort="auto(position)" sortDirection="ascending"/>
                                <column visible="@load(controller.byPercentage)" label="${i18n:_t('Percentage')}" align="center" width="180px"/>
                                <column label="${i18n:_t('Operations')}" align="center" width="120px"/>
                            </columns>
                        </grid>
                    </panelchildren>
                </panel>
            </tabpanel>
        </tabpanels>
    </tabbox>

    <!-- Control buttons -->
    <hbox>
        <button label="${i18n:_t('Save')}"
                onClick="controller.saveAndExit()" autodisable="self"
                sclass="save-button global-action"/>
        <button label="${i18n:_t('Save &amp; Continue')}"
                onClick="controller.saveAndContinue()"
                sclass="saveandcontinue-button global-action"/>
        <button label="${i18n:_t('Cancel')}"
                onClick="controller.cancelForm()"
                sclass="cancel-button global-action"/>
    </hbox>

    <zscript><![CDATA[
        i18iframe = org.libreplan.web.HelpLinkUtil.checkUrlPath(
            "/help/" + org.libreplan.web.I18nHelper._t("en") +
            "/12-formularios-calidad.html#administracion-de-formularios-de-calidade");
        ]]>
    </zscript>
    <popup id="quality-forms-popup" width="700px" onOpen='iframe.setSrc(i18iframe)'>
        <iframe id="iframe" width="100%" />
    </popup>

</window>
