<?page title="${i18n:_t('LibrePlan: Materials')}" id="labelTypesList"?>
<?init class="org.libreplan.web.common.AnnotateBinderInit" ?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/common/layout/template.zul"?>

<?link rel="shortcut icon" href="/common/img/favicon.ico" type="image/x-icon"?>

<?link rel="stylesheet" type="text/css" href="/common/css/libreplan.css"?>
<?link rel="stylesheet" type="text/css" href="/common/css/libreplan_zk.css"?>

<?variable-resolver class="org.zkoss.zkplus.spring.DelegatingVariableResolver"?>

<zk>
    <window self="@{define(content)}"
            apply="org.libreplan.web.materials.MaterialsController"
            title="${i18n:_t('Materials')}" >

        <!-- Categories  -->
        <vbox width="100%">

            <vbox id="messagesContainer" />

            <groupbox closable="false">
                <caption label="${i18n:_t('Categories')}" />
                <hbox>
                    <textbox id="txtCategory" onOK="materialsController.addMaterialCategory()"
                             style="padding-bottom: 4px" />
                    <button label="${i18n:_t('Add')}"
                            onClick="materialsController.addMaterialCategory()" sclass="add-button"/>
                    <separator spacing="20px" orient="vertical" />
                    <button label="${i18n:_t('Unselect')}"
                            onClick="materialsController.clearSelectionCategoriesTree()" sclass="add-button"/>
                </hbox>


                <tree id="categoriesTree" zclass="z-dottree"
                      rows="5" multiple="false"
                      model="@load(materialsController.materialCategories)"
                      itemRenderer="@load(materialsController.materialCategoryRenderer)"
                      onSelect="materialsController.refreshMaterials()">
                    <treecols>
                        <treecol label="${i18n:_t('Name')}" />
                        <treecol label="${i18n:_t('Code')}" />
                        <treecol label="${i18n:_t('Generate code')}" width="100px" />
                        <treecol label="${i18n:_t('Operations')}" width="80px" />
                    </treecols>
                </tree>
            </groupbox>
        </vbox>

        <!-- Materials -->
        <vbox width="100%">

            <groupbox closable="false">
                <caption id="materialsCaption" label="${i18n:_t('List of materials for all categories (select one to filter)')}"/>
                <button id="btnAddMaterial"
                        label="${i18n:_t('New')}" sclass="add-button"
                        onClick="materialsController.addMaterialToMaterialCategory(categoriesTree.selectedItem)" />
                <separator spacing="15px" orient="horizontal" />
                <newdatasortablegrid id="gridMaterials" mold="paging" pageSize="5"
                                     model="@load(materialsController.materials)"
                                     rowRenderer="@load(materialsController.materialRenderer)">
                    <columns>
                        <newdatasortablecolumn label="${i18n:_t('Code')}" />
                        <newdatasortablecolumn label="${i18n:_t('Description')}" />
                        <newdatasortablecolumn label="${i18n:_t('Unit price')}" />
                        <newdatasortablecolumn label="${i18n:_t('Unit type')}" />
                        <newdatasortablecolumn label="${i18n:_t('Category')}" />
                        <newdatasortablecolumn label="${i18n:_t('Disabled')}" width="80px" />
                        <newdatasortablecolumn label="${i18n:_t('Operations')}" width="80px" />
                    </columns>
                </newdatasortablegrid>
            </groupbox>
        </vbox>

        <!-- Save button -->
        <button onClick="materialsController.saveAndContinue()"
                label="${i18n:_t('Save')}"
                sclass="save-button global-action"/>

    </window>

</zk>
