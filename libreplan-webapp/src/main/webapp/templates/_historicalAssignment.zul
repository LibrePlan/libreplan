<zk>
    <zscript><![CDATA[
    historicalAssignment = self;
]]>
    </zscript>
    <vbox>
        <!-- Order element historic assignment to templates-->
        <vbox>
            <vbox id="messagesContainerHistoricAssignment" />
            <panel title="${i18n:_t('Assignment log')}" border="normal">
                <panelchildren>
                    <grid height="200px" sclass="margin-border"
                          model="@load(historicalAssignment.orderElementsWithThisAssignedTemplate)"
                          rowRenderer="@load(historicalAssignment.orderElementsWithThisAssignedTemplateRenderer)">
                        <columns>
                            <column label="${i18n:_t('Project code')}" sort="orderCode" sortDirection="descending"/>
                            <column label="${i18n:_t('Project Name')}" width="250px" sort="auto(name)" sortDirection="descending"/>
                            <column label="${i18n:_t('Task code')}" sort="auto(orderElementCode)" />
                            <column label="${i18n:_t('Task name')}" sort="auto(orderElementName)" />
                            <column label="${i18n:_t('Estimated hours')}" />
                            <column label="${i18n:_t('Worked hours')}" />
                            <column label="${i18n:_t('Operations')}" align="center" width="100px" />
                        </columns>
                        <rows>
                        </rows>
                    </grid>
                </panelchildren>
            </panel>
        </vbox>
    </vbox>
</zk>
