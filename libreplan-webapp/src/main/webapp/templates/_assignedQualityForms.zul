<zk>
    <zscript>
        <![CDATA[
        assignedQualityForms = self;
    ]]>
    </zscript>
    <vbox>
        <!-- Quality Forms-->
        <vbox>
            <vbox id="messagesContainerQualityForms" />
            <panel title="${i18n:_t('Quality forms')}" border="normal">
                <panelchildren>
                    <!-- Assign quality form -->
                    <vbox>
                        <label value="${i18n:_t('Assign quality form')}" />
                        <hbox style="margin-left: 5px;">
                            <bandboxSearch id="qualityFormFinder" finder="QualityFormBandboxFinder"
                                           model="@load(assignedQualityForms.notAssignedQualityForms)" widthBandbox="200px" widthListbox="600px" />
                            <button label="${i18n:_t('Assign')}" sclass="add-button"
                                    onClick="assignedQualityForms.onAssignTaskQualityForm()"
                            />
                        </hbox>
                    </vbox>
                    <separator bar="false" spacing="40px" orient="vertical"/>
                    <grid height="300px" style="margin: 0 5px 0 5px;"
                          model="@load(assignedQualityForms.assigned)"
                          rowRenderer="@load(assignedQualityForms.assignedRenderer)">
                        <columns>
                            <column width="25px"/>
                            <column label="${i18n:_t('Name')}" sort="auto(lower(name))" sortDirection="descending"/>
                            <column label="${i18n:_t('Type')}" />
                            <column label="${i18n:_t('Operations')}" />
                        </columns>
                        <rows>
                        </rows>
                    </grid>

                    <separator bar="false" spacing="40px" orient="vertical"/>
                </panelchildren>
            </panel>
        </vbox>
    </vbox>
</zk>
