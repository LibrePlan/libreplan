<panel title="${i18n:_t('Materials')}" border="normal">
    <panelchildren>
        <newdatasortablegrid id="gridMaterials"
                             sclass="margin-border"
                             model="@load(assignedMaterialsController.assignedMaterials)"
                             rowRenderer="@load(assignedMaterialsController.materialAssignmentsRenderer)">
            <columns>
                <newdatasortablecolumn label="${i18n:_t('Code')}" />
                <newdatasortablecolumn label="${i18n:_t('Units')}" />
                <newdatasortablecolumn label="${i18n:_t('Unit type')}" />
                <newdatasortablecolumn label="${i18n:_t('Unit price')}" />
                <newdatasortablecolumn label="${i18n:_t('Total price')}" />
                <newdatasortablecolumn label="${i18n:_t('Category')}" />
                <newdatasortablecolumn label="" />
            </columns>
            <rows>
            </rows>
        </newdatasortablegrid>
    </panelchildren>
</panel>
