<window id="${arg.top_id}">
    <caption id="caption" sclass="caption-title" />
    <tabbox>
        <tabs>
            <tab label="${i18n:_t('Edit')}"/>
        </tabs>
        <tabpanels>
            <tabpanel>
                <grid>
                    <columns>
                        <column width="200px" />
                        <column  />
                    </columns>

                    <rows>
                        <row>
                            <label value="${i18n:_t('Unit name')}" />
                            <textbox id="unitName"
                                     value="@load(controller.advanceType.unitName) @save(controller.advanceType.unitName)"
                                     constraint="@load(controller.distinctNames())"
                                     width="300px"
                                     disabled="@load(controller.immutable)"
                                     onBlur="controller.updateWindowTitle()"
                                     sclass="focus-element" />
                        </row>
                        <row>
                            <label value="${i18n:_t('Active')}" />
                            <checkbox checked="@load(controller.advanceType.active) @save(controller.advanceType.active)"
                                      disabled="@load(controller.immutable)" />
                        </row>
                        <row>
                            <label value="${i18n:_t('Default max value')}" />
                            <decimalbox id="defaultMaxValue"
                                        scale="2"
                                        width="300px"
                                        value="@load(controller.defaultMaxValue) @save(controller.defaultMaxValue)"
                                        constraint="@load(controller.greaterThanPrecision())"
                                        disabled="@load(controller.percentage)" />
                        </row>
                        <row>
                            <label value="${i18n:_t('Precision')}" />
                            <decimalbox id="precision"
                                        scale="4"
                                        width="300px"
                                        value = "@load(controller.advanceType.unitPrecision) @save(controller.advanceType.unitPrecision)"
                                        constraint = "@load(controller.lessThanDefaultMaxValue())"
                                        disabled="@load(controller.immutable)" />
                        </row>
                        <row>
                            <label value="${i18n:_t('Type')}" />
                            <label value="@load(controller.advanceType.type)" />
                        </row>
                        <row>
                            <label value="${i18n:_t('Percentage')}" />
                            <checkbox id="percentage"
                                      checked="@load(controller.percentage) @save(controller.percentage)"
                                      disabled="@load(controller.immutable)" />
                        </row>
                    </rows>
                </grid>
            </tabpanel>
        </tabpanels>
    </tabbox>

    <button onClick="controller.saveAndExit();"
            autodisable="self"
            label="${arg.save_button_label}"
            sclass="save-button global-action"
            disabled="@load(controller.immutable)" />
    <button onClick="controller.saveAndContinue();"
            label="${arg.save_and_continue_button_label}"
            sclass="save-button global-action"
            disabled="@load(controller.immutable)" />
    <button onClick="controller.cancelForm();"
            label="${arg.cancel_button_label}"
            sclass="cancel-button global-action" />
</window>
