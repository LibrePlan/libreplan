<window id="${arg.top_id}" title="${i18n:_t('Work Hours Types List')}">
    <!-- rows built programmatically via controller.typeOfWorkHoursRenderer instead of a ZUML
         "each" template - "@{each=...}" only ever clones a row's FIRST child under this app's
         AnnotateBinder/ZK 10 stack. -->
    <newdatasortablegrid id="listing" model="@load(controller.typesOfWorkHours)"
        rowRenderer="@load(controller.typeOfWorkHoursRenderer)" mold="paging"
        pageSize="10" sclass="clickable-rows">
        <columns sizable="true">
            <newdatasortablecolumn label="${i18n:_t('Code')}" sort="auto(code)" />
            <newdatasortablecolumn label="${i18n:_t('Type name')}" sort="auto(name)" />
            <newdatasortablecolumn label="${i18n:_t('Default price')}" sort="auto(defaultPrice)" />
            <newdatasortablecolumn label="${i18n:_t('Enabled')}" sort="auto(enabled)"/>
            <newdatasortablecolumn label="${i18n:_t('Actions')}" />
        </columns>
    </newdatasortablegrid>

    <button id="show_create_form" onClick="controller.goToCreateForm();"
        label="${i18n:_t('Create')}" sclass="create-button global-action" />
</window>
