<window id="${arg.id}" title="${i18n:_t('Job Scheduling List')}">

    <grid id="listJobSchedulings"
          rowRenderer="@load(controller.jobSchedulingRenderer)"
          model="@load(controller.jobSchedulerConfigurations)"
          mold="paging" pageSize="10">

        <columns>
            <column label="${i18n:_t('Job group')}" />
            <column label="${i18n:_t('Job name')}" />
            <column label="${i18n:_t('Cron expression')}" />
            <column label="${i18n:_t('Next fire time')}" />
            <column label="${i18n:_t('Operations')}" />
        </columns>

    </grid>
    <button label="${i18n:_t('Create')}" onClick="controller.goToCreateForm()" sclass="add-button global-action"/>
</window>
