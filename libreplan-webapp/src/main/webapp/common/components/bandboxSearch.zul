<zk xmlns:n="http://www.zkoss.org/2005/zk/native" xmlns:c="http://www.zkoss.org/2005/zk/client">

    <zscript>
        <![CDATA[
            top = self;
        ]]>
    </zscript>

    <!--
      closeBandbox() used to be declared here as a per-instance native <n:script>. Every
      BandboxMultipleSearch/BandboxSearch instance redeclared the identical global function, and
      re-mounting that native stub after a detach+reattach cycle (e.g. switching planner tabs)
      would fail with "Unknown stub" client errors, aborting the rest of that AU response and
      leaving the reattached tab blank. The function is stateless, so it's now loaded once,
      globally, via common/js/bandbox-search.js (included from common/layout/template.zul).
    -->

    <bandbox id="bandbox" autodrop="true">
        <bandpopup>
            <vbox height="170px">
                <listbox id="listbox" width="200px" sclass="bandbox-search" height="150px"
                         model="${arg.model}"
                         c:onClick="closeBandbox(this.$f('bandbox').parent);">
                    <listhead id="listhead" />
                </listbox>
            </vbox>
        </bandpopup>
    </bandbox>

</zk>
