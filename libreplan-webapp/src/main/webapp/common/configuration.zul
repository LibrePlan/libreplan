<?page title="${i18n:_t('LibrePlan: Main Settings')}"?>
<?init class="org.libreplan.web.common.AnnotateBinderInit" ?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?page  id="List"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/common/layout/template.zul"?>
<?link rel="shortcut icon" href="/common/img/favicon.ico" type="image/x-icon"?>
<?link rel="stylesheet" type="text/css" href="/common/css/libreplan.css"?>
<?link rel="stylesheet" type="text/css" href="/common/css/libreplan_zk.css"?>
<?variable-resolver class="org.zkoss.zkplus.spring.DelegatingVariableResolver"?>
<zk>

    <window id="configurationWindow" self="@{define(content)}"
            apply="org.libreplan.web.common.ConfigurationController"
            title="${i18n:_t('Main Settings')}">

        <vbox id="messagesContainer" width="30%" />

        <tabbox>

            <tabs>
                <tab label="${i18n:_t('Main preferences')}" />
                <tab label="${i18n:_t('Entity sequences')}" />
                <tab label="${i18n:_t('LDAP configuration')}" />
                <tab label="${i18n:_t('Connectors')}" />
            </tabs>

            <tabpanels>

                <tabpanel id="panelConfiguration">

                    <grid id="configurationVariables">
                        <columns>
                            <column width="200px" />
                            <column />
                        </columns>

                        <rows>
                            <row>
                                <label
                                        value="${i18n:_t('Company code')}" />
                                <textbox id="companyCode"
                                         value="@load(configurationController.companyCode)@save(configurationController.companyCode)"
                                         constraint="no empty:${i18n:_t('cannot be empty')}" />
                            </row>

                            <row>
                                <label value="${i18n:_t('Default calendar')}" />
                                <bandboxSearch id="defaultCalendarBandboxSearch"
                                               finder="BaseCalendarBandboxFinder"
                                               model="@load(configurationController.calendars)"
                                               selectedElement="@load(configurationController.defaultCalendar)" />
                            </row>

                            <row>
                                <label value="${i18n:_t('Hours type for personal timesheets')}" />
                                <bandboxSearch id="personalTimesheetsTypeOfWorkHoursBandboxSearch"
                                        finder="TypeOfWorkHoursBandboxFinder"
                                        selectedElement="@load(configurationController.personalTimesheetsTypeOfWorkHours)" />
                            </row>
                            <row>
                                <label value="${i18n:_t('Personal timesheets peridocity')}" />
                                <listbox model="@load(configurationController.personalTimesheetsPeriodicities)"
                                         itemRenderer="@load(configurationController.personalTimesheetsPeriodicityRenderer)"
                                         selectedItem="@load(configurationController.selectedPersonalTimesheetsPeriodicity)@save(configurationController.selectedPersonalTimesheetsPeriodicity)"
                                         disabled="@load(configurationController.personalTimesheetsPeriodicityDisabled)"
                                         tooltiptext="@load(configurationController.personalTimesheetsPeriodicityTooltip)"
                                         mold="select" />
                            </row>

                            <row>
                                <label value="${i18n:_t('Show progress')}" />
                                <listbox id="lbTypeProgress"
                                         model="@load(configurationController.progressTypes)"
                                         itemRenderer="@load(configurationController.progressTypeRenderer)"
                                         selectedItem="@load(configurationController.selectedProgressType)@save(configurationController.selectedProgressType)"
                                         mold="select" />
                            </row>

                            <row>
                                <label value="${i18n:_t('Company logo URL')}" />
                                <hbox>
                                    <textbox id="companyLogoURL"
                                             value="@load(configurationController.companyLogoURL)"
                                             width="200px" readonly="true" />

                                    <button label="Upload" upload="true,maxsize=999"
                                            onUpload="configurationController.importLogo(event.getMedia())"/>

                                    <image id="logoPreview" height="20px" width="20px"
                                           onCreate="configurationController.setPreviewLogo()"/>

                                    <button label="Delete image" onClick="configurationController.removeLogo()"/>
                                </hbox>

                            </row>

                            <row>
                                <label value="${i18n:_t('Currency')}" />
                                <listbox id="currencyListbox"
                                         model="@load(configurationController.currenciesModel)"
                                         itemRenderer="@load(configurationController.currencyRenderer)"
                                         selectedItem="@load(configurationController.selectedCurrency)@save(configurationController.selectedCurrency)"
                                         mold="select" />
                            </row>

                            <row>
                                <label value="${i18n:_t('Autocomplete login form')}" />
                                <checkbox
                                        id="enableAutocompleteLogin"
                                        label="${i18n:_t('Enable/Disable')}"
                                        disabled="@load(configurationController.changedDefaultPasswdAdmin)"

                                        tooltiptext = "${i18n:_t('Enable/Disable autocomplete property in login form,
                                        if the admin password is still the default one')}"

                                        checked="@load(configurationController.autocompleteLogin)@save(configurationController.autocompleteLogin)"
                                        onCheck="configurationController.reloadGeneralConfiguration();" />
                            </row>

                            <row>
                                <label value="${i18n:_t('Check for updates')}" />
                                <vbox>
                                    <checkbox
                                            label="${i18n:_t('Show a notification when new LibrePlan versions are released')}"
                                            tooltiptext="${i18n:_t('Enable/Disable warning about new LibrePlan versions available')}"
                                            checked="@load(configurationController.checkNewVersionEnabled)@save(configurationController.checkNewVersionEnabled)" />
                                    <checkbox
                                            label="${i18n:_t('Allow collection of anonymous statistics to help us improve LibrePlan')}"
                                            tooltiptext="${i18n:_t('Check this option if you would like to send feedback to LibrePlan developers about program usage')}"
                                            checked="@load(configurationController.allowedToGatherUsageStatsEnabled)@save(configurationController.allowedToGatherUsageStatsEnabled)"/>
                                </vbox>
                            </row>

                            <row>
                                <label value="${i18n:_t('Generate code for')}" />
                                <grid>
                                    <columns>
                                        <column width="50%" />
                                        <column />
                                    </columns>

                                    <rows>
                                        <row>
                                            <checkbox
                                                    label="${i18n:_t('Criteria')}"
                                                    checked="@load(configurationController.generateCodeForCriterion)@save(configurationController.generateCodeForCriterion)"
                                                    onCheck="configurationController.reloadGeneralConfiguration();" />
                                            <checkbox
                                                    label="${i18n:_t('Labels')}"
                                                    checked="@load(configurationController.generateCodeForLabel)@save(configurationController.generateCodeForLabel)"
                                                    onCheck="configurationController.reloadGeneralConfiguration();" />
                                        </row>

                                        <row>
                                            <checkbox
                                                    label="${i18n:_t('Timesheets')}"
                                                    checked="@load(configurationController.generateCodeForWorkReport)@save(configurationController.generateCodeForWorkReport)"
                                                    onCheck="configurationController.reloadGeneralConfiguration();" />
                                            <checkbox
                                                    label="${i18n:_t('Resources')}"
                                                    checked="@load(configurationController.generateCodeForResources)@save(configurationController.generateCodeForResources)"
                                                    onCheck="configurationController.reloadGeneralConfiguration();" />
                                        </row>

                                        <row>
                                            <checkbox
                                                    label="${i18n:_t('Hours Types')}"
                                                    checked="@load(configurationController.generateCodeForTypesOfWorkHours)@save(configurationController.generateCodeForTypesOfWorkHours)"
                                                    onCheck="configurationController.reloadGeneralConfiguration();" />
                                            <checkbox
                                                    label="${i18n:_t('Material categories')}"
                                                    checked="@load(configurationController.generateCodeForMaterialCategories)@save(configurationController.generateCodeForMaterialCategories)"
                                                    onCheck="configurationController.reloadGeneralConfiguration();" />
                                        </row>

                                        <row>
                                            <checkbox
                                                    label="${i18n:_t('Material Units')}"
                                                    checked="@load(configurationController.generateCodeForUnitTypes)@save(configurationController.generateCodeForUnitTypes)"
                                                    onCheck="configurationController.reloadGeneralConfiguration();" />
                                            <checkbox
                                                    label="${i18n:_t('Calendar')}"
                                                    checked="@load(configurationController.generateCodeForBaseCalendars)@save(configurationController.generateCodeForBaseCalendars)"
                                                    onCheck="configurationController.reloadGeneralConfiguration();" />
                                        </row>

                                        <row>
                                            <checkbox
                                                    label="${i18n:_t('Timesheet templates')}"
                                                    checked="@load(configurationController.generateCodeForWorkReportType)@save(configurationController.generateCodeForWorkReportType)"
                                                    onCheck="configurationController.reloadGeneralConfiguration();" />
                                            <checkbox
                                                    label="${i18n:_t('Calendar exception days')}"
                                                    checked="@load(configurationController.generateCodeForCalendarExceptionType)@save(configurationController.generateCodeForCalendarExceptionType)"
                                                    onCheck="configurationController.reloadGeneralConfiguration();" />
                                        </row>

                                        <row>
                                            <checkbox
                                                    label="${i18n:_t('Cost category')}"
                                                    checked="@load(configurationController.generateCodeForCostCategory)@save(configurationController.generateCodeForCostCategory)"
                                                    onCheck="configurationController.reloadGeneralConfiguration();" />
                                            <checkbox
                                                    label="${i18n:_t('Expense sheets')}"
                                                    checked="@load(configurationController.generateCodeForExpenseSheets)@save(configurationController.generateCodeForExpenseSheets)"
                                                    onCheck="configurationController.reloadGeneralConfiguration();" />
                                        </row>
                                    </rows>
                                </grid>
                            </row>

                            <!-- Perspectives -->
                            <row>
                                <label value="${i18n:_t('Perspectives')}" />
                                <checkbox label="${i18n:_t('MonteCarlo method')}"
                                          checked="@load(configurationController.monteCarloMethodTabVisible)@save(configurationController.monteCarloMethodTabVisible)" />
                            </row>

                            <!-- Automatic budget -->
                            <row>
                                <label value="${i18n:_t('Automatic budget')}" />
                                <hbox align="pack">
                                    <label value="${i18n:_t('Hours type')}" />
                                    <bandboxSearch id="budgetDefaultTypeOfWorkHoursBandboxSearch"
                                            finder="TypeOfWorkHoursBandboxFinder"
                                            selectedElement="@load(configurationController.budgetDefaultTypeOfWorkHours)" />
                                    <checkbox
                                            label="${i18n:_t('calculate based on task criteria and cost categories')}"
                                            checked="@load(configurationController.enabledAutomaticBudget)@save(configurationController.enabledAutomaticBudget)" />
                                </hbox>
                            </row>

                            <row>
                                <label value="${i18n:_t('Seconds planning warning')}" />
                                <hbox>
                                    <intbox width="50px" value="@load(configurationController.secondsPlanningWarning)@save(configurationController.secondsPlanningWarning)"
                                            constraint="no empty,no negative:${i18n:_t('cannot be negative or empty')}" />
                                    <label
                                            value="${i18n:_t('Defines the time since last saving operation at project
                                        planning perspectives after which a warning is raised on leaving. Set to 0 in order to disable the warning.')}" />
                                </hbox>
                            </row>

                            <row>
                                <label value="${i18n:_t('Local document repository location')}"/>
                                <textbox id="repoLocation" width="300px"
                                         tooltiptext="Example: /example/repository/path/"
                                         value="@load(configurationController.repositoryLocation)@save(configurationController.repositoryLocation)"
                                         constraint="/(\/.*\/$|^$)/:Example: /example/repository/path/"/>
                            </row>
                        </rows>
                    </grid>

                </tabpanel>

                <tabpanel id="panelEntitySequences">
                    <panel border="normal" title="Entity code sequences">
                        <panelchildren id="panelEntitySequence">
                            <vbox>

                                <hbox pack="center" style="margin-top: 10px;">
                                    <label value="${i18n:_t('Select entity')}" />
                                    <combobox id="entityCombo"
                                              model="@load(configurationController.entityNamesModel)"
                                              itemRenderer="@load(configurationController.entityNamesRenderer)" />
                                    <label value="${i18n:_t('Prefix')}" />
                                    <textbox id="prefixBox" />
                                    <label value="${i18n:_t('Number of digits')}" />
                                    <intbox id="numDigitBox" value="5" />
                                    <button label="${i18n:_t('Add')}" sclass="add-button"
                                            onClick="configurationController.addNewEntitySequence()" />
                                </hbox>

                                <separator bar="false" height="4px" orient="vertical" />

                                <grid id="entitySequencesGrid"
                                      sizedByContent="false" height="400px" sclass="entity-sequences-grid"
                                      rowRenderer="@load(configurationController.entitySequenceGroupRenderer)">
                                    <columns>
                                        <column label="${i18n:_t('Entity type')}" />
                                        <column label="${i18n:_t('Active')}" />
                                        <column label="${i18n:_t('Prefix')}" />
                                        <column label="${i18n:_t('Number of digits')}" />
                                        <column label="${i18n:_t('Last value')}" />
                                        <column label="${i18n:_t('Operations')}" />
                                    </columns>
                                </grid>

                            </vbox>
                        </panelchildren>
                    </panel>
                </tabpanel>

                <tabpanel id="panelLDAPConfiguration">

                    <!-- Activation -->
                    <groupbox style="margin-top: 5px" closable="false">
                        <caption label="${i18n:_t('Activation')}" />
                        <label value="${i18n:_t('Enable LDAP authentication')}" />
                        <checkbox id="ldapAuthEnabled"
                                  checked="@load(configurationController.ldapConfiguration.ldapAuthEnabled)@save(configurationController.ldapConfiguration.ldapAuthEnabled)" />
                        <label value="${i18n:_t('Use LDAP roles')}" />
                        <checkbox id="ldapSaveRolesDB"
                                  checked="@load(configurationController.ldapConfiguration.ldapSaveRolesDB)@save(configurationController.ldapConfiguration.ldapSaveRolesDB)" />
                    </groupbox>

                    <!-- Configuration -->
                    <groupbox style="margin-top: 5px" closable="false">
                        <caption label="${i18n:_t('Configuration')}" />
                        <grid>

                            <columns>
                                <column width="200px" />
                                <column />
                            </columns>

                            <rows>
                                <row>
                                    <label value="${i18n:_t('Host')}" />
                                    <hbox>
                                        <textbox id="ldapHost"
                                                 value="@load(configurationController.ldapConfiguration.ldapHost)@save(configurationController.ldapConfiguration.ldapHost)"
                                                 width="300px"/>
                                        <label value="${i18n:__t('Example: {0}', 'ldap://localhost')}" />
                                    </hbox>
                                </row>

                                <row>
                                    <label value="${i18n:_t('Port')}" />
                                    <hbox>
                                        <textbox id="ldapPort"
                                                 value="@load(configurationController.ldapConfiguration.ldapPort)@save(configurationController.ldapConfiguration.ldapPort)"
                                                 width="300px"
                                                 maxlength="5"/>
                                        <label value="${i18n:__t('Example: {0}', '389')}" />
                                    </hbox>
                                </row>

                                <row>
                                    <label value="${i18n:_t('Base')}" />
                                    <hbox>
                                        <textbox id="ldapBase"
                                                 value="@load(configurationController.ldapConfiguration.ldapBase)@save(configurationController.ldapConfiguration.ldapBase)"
                                                 width="300px"/>
                                        <label value="${i18n:__t('Example: {0}', 'dc=example,dc=org')}" />
                                    </hbox>
                                </row>

                                <row>
                                    <label value="${i18n:_t('UserDn')}" />
                                    <hbox>
                                        <textbox id="ldapUserDn"
                                                 value="@load(configurationController.ldapConfiguration.ldapUserDn)@save(configurationController.ldapConfiguration.ldapUserDn)"
                                                 width="300px"/>
                                        <label value="${i18n:__t('Example: {0}', 'cn=admin,dc=example,dc=org')}" />
                                    </hbox>
                                </row>

                                <row>
                                    <label value="${i18n:_t('Password')}" />
                                    <textbox id="ldapPassword"
                                             value="@load(configurationController.ldapConfiguration.ldapPassword)@save(configurationController.ldapConfiguration.ldapPassword)"
                                             type="password"  width="300px"/>
                                </row>
                            </rows>
                        </grid>

                        <separator />

                        <button label="${i18n:_t('Test LDAP connection')}" sclass="add-button"
                                onClick="configurationController.testLDAPConnection()" />

                        <separator />
                    </groupbox>

                    <!-- Authentication -->
                    <groupbox style="margin-top: 5px" closable="false">
                        <caption label="${i18n:_t('Authentication')}" />
                        <grid>

                            <columns>
                                <column width="200px" />
                                <column />
                            </columns>

                            <rows>
                                <row>
                                    <label value="${i18n:_t('UserId')}" />
                                    <hbox>
                                        <textbox id="ldapUserId"
                                                 value="@load(configurationController.ldapConfiguration.ldapUserId)@save(configurationController.ldapConfiguration.ldapUserId)"
                                                 width="300px"/>
                                        <label value="${i18n:__t('Example: {0}', 'uid')}" />
                                    </hbox>
                                </row>

                                <row>
                                    <label value="${i18n:_t('Save passwords in database')}" />
                                    <checkbox id="ldapSavePasswordsDB"
                                              checked="@load(configurationController.ldapConfiguration.ldapSavePasswordsDB)@save(configurationController.ldapConfiguration.ldapSavePasswordsDB)" />
                                </row>

                            </rows>
                        </grid>

                    </groupbox>

                    <!-- Authorization -->
                    <groupbox style="margin-top: 5px" closable="false">
                        <caption label="${i18n:_t('Authorization')}" />

                        <grid>

                            <columns>
                                <column width="200px" />
                                <column />
                            </columns>

                            <rows>
                                <row>
                                    <label value="${i18n:_t('Role search strategy')}" />
                                    <radiogroup id="strategy" onCheck="configurationController.changeRoleStrategy()">
                                        <radio label="${i18n:_t('Group strategy')}" value="group" />
                                        <radio label="${i18n:_t('Property strategy')}" value="property" />
                                    </radiogroup>
                                </row>

                                <row>
                                    <label value="${i18n:_t('Group path')}" />
                                    <hbox>
                                        <textbox id="ldapGroupPath"
                                                 value="@load(configurationController.ldapConfiguration.ldapGroupPath)@save(configurationController.ldapConfiguration.ldapGroupPath)"
                                                 width="300px"
                                                 disabled="@load(configurationController.ldapPropertyStrategy)" />
                                        <label value="${i18n:__t('Example: {0}', 'ou=groups')}" />
                                        <label value="${i18n:_t('(If it is empty, a node strategy is used)')}" />
                                    </hbox>
                                </row>

                                <row>
                                    <label value="${i18n:_t('Role property')}" />
                                    <hbox>
                                        <textbox id="ldapRoleProperty"
                                                 value="@load(configurationController.ldapConfiguration.ldapRoleProperty)@save(configurationController.ldapConfiguration.ldapRoleProperty)"
                                                 width="300px" />
                                        <label value="${i18n:__t('Example: {0}', 'member')}" />
                                    </hbox>
                                </row>

                                <row>
                                    <label value="${i18n:_t('Role search query')}" />
                                    <hbox>
                                        <textbox id="ldapSearchQuery"
                                                 value="@load(configurationController.ldapConfiguration.ldapSearchQuery)@save(configurationController.ldapConfiguration.ldapSearchQuery)"
                                                 width="300px" />
                                        <label value="${i18n:__t('Example: {0}', 'uid=[USER_ID],ou=people,dc=example,dc=org')}" />
                                    </hbox>
                                </row>
                            </rows>
                        </grid>

                        <separator />

                        <separator />

                        <vbox id="ldapRoles">
                            <grid id="configurationRoles"
                                  model="@load(configurationController.rolesModel)"
                                  rowRenderer="@load(configurationController.allUserRolesRenderer)"
                                  mold="paging" pageSize="10" sizedByContent="true">
                                <columns>
                                    <column label="${i18n:_t('LibrePlan Role')}" width="200px" />
                                    <column label="${i18n:_t('LDAP Roles (separated by ;)')}" />
                                </columns>
                            </grid>
                        </vbox>

                    </groupbox>
                </tabpanel>

                <tabpanel id="panelConnectors">
                    <groupbox style="margin-top: 5px" closable="false">
                        <caption label="${i18n:_t('Application properties')}" />
                        <vbox>

                            <hbox pack="center">
                                <label value="${i18n:_t('Select connector')}" />
                                <combobox id="connectorCombo" autodrop="true"
                                          model="@load(configurationController.connectorsModel)"
                                          itemRenderer="@load(configurationController.connectorsRenderer)"
                                          selectedItem="@load(configurationController.selectedConnector)@save(configurationController.selectedConnector)" />
                            </hbox>

                            <separator />

                            <grid id="connectorPropertriesGrid"
                                  model="@load(configurationController.connectorPropertries)"
                                  rowRenderer="@load(configurationController.connectorPropertriesRenderer)">

                                <columns>
                                    <column label="${i18n:_t('Name')}" width="200px"/>
                                    <column label="${i18n:_t('Value')}" />
                                </columns>

                            </grid>
                        </vbox>

                        <separator />

                        <button label="${i18n:_t('Test connection')}" sclass="add-button"
                                onClick="configurationController.testConnection()" />
                    </groupbox>
                </tabpanel>
            </tabpanels>
        </tabbox>

        <hbox>
            <button label="${i18n:_t('Save')}"
                    sclass="save-button global-action"
                    onClick="configurationController.save()" />
            <button label="${i18n:_t('Cancel')}"
                    sclass="cancel-button global-action"
                    onClick="configurationController.cancel()" />
        </hbox>

    </window>

</zk>
