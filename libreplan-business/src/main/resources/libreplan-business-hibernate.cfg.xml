<!DOCTYPE hibernate-configuration
        PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <property name="hibernate.dialect">${hibernate.dialect}</property>
        <property name="hibernate.show_sql">${hibernate.show_sql}</property>
        <property name="hibernate.format_sql">${hibernate.format_sql}</property>
        <property name="hibernate.use_sql_comments">${hibernate.use_sql_comments}</property>
        <property name="hibernate.hbm2ddl.auto">${hibernate.hbm2ddl.auto}</property>

        <!-- If you want to measure/tune Hibernate performance, use this flag -->
        <!-- <property name="hibernate.generate_statistics">true</property> -->

        <!--
        We explicitly call validation, otherwise infinite loops can happen.
        Sometimes DAOs are queried when validating some constraints.
        When the DAO does a query, the pending changes are flushed, causing the validations to be run again.
         -->
        <property name="javax.persistence.validation.mode">none</property>

        <!--
            org.jadira.usertype:usertype.core (which the jadira.usertype.* properties configured)
            was removed - Hibernate-6-incompatible. Its explicit usages were replaced with
            hand-written UserTypes (see the .workingday.hibernate package); its implicit global
            auto-registration of Joda-Time types has no Hibernate 6 equivalent, so every previously
            bare (no explicit type=) LocalDate/DateTime .hbm.xml property now sets one explicitly
            instead.
        -->

        <!--
            Second level cache disabled. It was previously on via hibernate-jcache's
            JCacheRegionFactory (hibernate-ehcache/EhCacheRegionFactory never reached GA for
            Hibernate 6 - see the dependency comment in the root pom.xml), falling back to a
            default-tuned JCache CacheManager since the old ehcache.xml is 2.x-schema and
            unreadable by JCacheRegionFactory. That combination was found to silently hand back
            hollow entities (every field null, not just lazy associations) on a second read of the
            same nonstrict-read-write-cached rows within one request - e.g. LabelTypeModel.getLabels()
            reads the same Label rows twice per edit-form load and the second read came back empty,
            confirmed via direct DEBUG logging of the fetched entities. Silent data corruption is a
            materially worse failure mode than a bit of lost read performance, so caching is off
            entirely until this is properly root-caused and reconfigured.
        -->
        <property name="hibernate.cache.use_second_level_cache">false</property>
        <property name="hibernate.cache.use_query_cache">false</property>

    </session-factory>
</hibernate-configuration>
